# ============================================================================
# Meridian Estates — Real Estate Management Dashboard
# Backend configuration.
#
# Copy this file to `backend/.env` and fill in real values. `spring-dotenv`
# loads `.env` at startup; a host environment variable always takes precedence,
# so a container or service manager can override anything here.
#
# Nothing in this file is a credential. The committed file carries the local
# development defaults; `DB_PASSWORD` in your `.env` is the only secret, and
# `.env` is gitignored.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
SERVER_PORT=8083
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:4175,http://localhost:3000

# Where the data comes from.
#
#   sqlfiles  An ephemeral PostgreSQL is started on this machine at boot and seeded by the Flyway
#             chain in db/migration alone, so the product runs with no database to install. Nothing
#             is read from the DB_* server below, the server is discarded at shutdown, and every
#             write is lost with it. Refused unless APP_ENV is development, local or test - see
#             SqlFileDataSourcePostProcessor.
#   postgres  The DB_* server below. This is the default in application.yml, and the only mode a
#             deployment uses.
APP_DATA_SOURCE=sqlfiles

# ----------------------------------------------------------------------------
# Database — PostgreSQL 5432, this product's own database and schema.
#
# This product owns `real_estate` and nothing else. It never reads or writes
# another dashboard's database.
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=real_estate
DB_USERNAME=real_estate
DB_PASSWORD=change-me-in-your-env
DB_SCHEMA=real_estate

# Optional: a full JDBC URL that overrides the parts above.
# DATABASE_URL=jdbc:postgresql://localhost:5432/real_estate

# ----------------------------------------------------------------------------
# Secrets — REQUIRED for any non-local deployment.
#
# SecretStartupGuard refuses to start with a development default against a
# non-local database, so this cannot be shipped by accident.
# ----------------------------------------------------------------------------
JWT_SECRET=meridian-estates-local-development-secret-key-2026-very-long-random-value

# ----------------------------------------------------------------------------
# The firm (Settings -> Firm Profile)
#
# One installation serves one firm, so the profile is configuration rather than
# a table. These values appear on the shell, the dashboard's context line,
# reports and notification copy.
# ----------------------------------------------------------------------------
FIRM_NAME=Meridian Estates
FIRM_CODE=ME-001
FIRM_EMAIL=advisory@meridianestates.example
FIRM_PHONE=+91-22-6155-4400
FIRM_ADDRESS=Meridian House, 14 Ballard Estate, Fort, Mumbai 400001
FIRM_LICENCE=RERA/ME/2026/0114

# ----------------------------------------------------------------------------
# Money
# ----------------------------------------------------------------------------
FEE_CURRENCY=INR
FEE_CURRENCY_SYMBOL=Rs.

# ----------------------------------------------------------------------------
# Portfolio policy — the thresholds the dashboard and reports reason about.
# ----------------------------------------------------------------------------
# A lease inside this window is called out as expiring.
LEASE_EXPIRY_WARNING_DAYS=60
# A lease inside this window is urgent.
LEASE_EXPIRY_URGENT_DAYS=30
# Rent falls due on this day of the month.
RENT_DUE_DAY=5
# Days past due before an invoice is reported as overdue rather than outstanding.
RENT_OVERDUE_GRACE_DAYS=5
# The occupancy the portfolio is managed against, for the gauge's target mark.
OCCUPANCY_TARGET_PERCENT=92
# A listing unsold/unlet beyond this many days is flagged as stale.
LISTING_STALE_DAYS=45
# How long before a viewing the prospect is expected to be reminded.
VIEWING_REMINDER_HOURS=24
# A maintenance request unanswered beyond this is late.
MAINTENANCE_URGENT_HOURS=24
# The window the dashboard and trend charts summarise.
TREND_MONTHS=14

# ----------------------------------------------------------------------------
# Data import (INSERT-ONLY)
#
# Files are parsed in memory and never persisted. The limits bound the work a
# single request can ask for.
# ----------------------------------------------------------------------------
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_MAX_ROWS=5000
IMPORT_BATCH_SIZE=200

# ----------------------------------------------------------------------------
# Industry / product platform
#
# Both are chosen at build/deploy time — there is deliberately no runtime
# switcher, because a product ships as source code configured for one industry.
# ----------------------------------------------------------------------------
INDUSTRY=REAL_ESTATE
PRODUCT_CODE=REAL_ESTATE_DASHBOARD

# Optional rebranding for a purchased installation. Leave blank to use
# Meridian Estates' own identity.
BRAND_PRODUCT_NAME=
BRAND_NAME=
BRAND_COMPANY_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_LOGIN_HEADLINE=
BRAND_LOGIN_SUBHEADLINE=
BRAND_PRIMARY_COLOR=
BRAND_SECONDARY_COLOR=
