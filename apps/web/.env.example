# Meridian Estates - Real Estate Management Dashboard
# Build-time frontend settings. These are only the fallback used before
# GET /api/v1/platform/profile answers; the backend is the runtime source of
# truth for the product's identity, the firm's vocabulary and the sidebar.
#
# Nothing here may ever hold a secret: every VITE_* value is compiled into the
# browser bundle and is readable by anyone who loads the app.

# Where the data comes from.
#
#   local  (the default when this is unset)  Every request is answered in the browser from the
#                                            dataset bundled under `src/data`, which is generated
#                                            from the migrations by `npm run generate:demo-data`.
#                                            This is what a Vercel deployment uses, and it needs no
#                                            backend at all.
#   api                                      The real calls below. Use this when you are running the
#                                            Spring Boot service as well.
#
# The default is `local` in code rather than here, deliberately: Vercel builds with no environment
# variables set, so a default that lived only in this file would deploy a bundle reaching for
# localhost:8083.
# VITE_DATA_SOURCE=local

# Where the API lives, when VITE_DATA_SOURCE=api. Defaults to this product's own development port.
VITE_API_BASE_URL=http://localhost:8083/api/v1

# Product identity, used only before the platform profile arrives.
VITE_PRODUCT_CODE=REAL_ESTATE_DASHBOARD
VITE_PRODUCT_NAME=Real Estate Management Dashboard
VITE_INDUSTRY_CODE=REAL_ESTATE

# Optional rebranding for a purchased installation. Leave blank to use
# Meridian Estates' own identity.
VITE_BRAND_PRODUCT_NAME=
VITE_BRAND_NAME=
VITE_BRAND_COMPANY_NAME=
VITE_BRAND_LOGO_URL=
VITE_BRAND_FAVICON_URL=
VITE_BRAND_LOGIN_HEADLINE=
VITE_BRAND_LOGIN_SUBHEADLINE=
VITE_BRAND_SIDEBAR_LABEL=
VITE_BRAND_FOOTER_TEXT=
VITE_BRAND_PRIMARY_COLOR=
VITE_BRAND_SECONDARY_COLOR=
